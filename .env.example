# Copy to .env and fill in. Never commit .env.

# MySQL 8 connection (docker-compose overrides this for the backend container)
DATABASE_URL=mysql+pymysql://ecgauth:change-me@localhost:3306/ecgauth?charset=utf8mb4

# Used by docker-compose for the mysql container
MYSQL_DATABASE=ecgauth
MYSQL_USER=ecgauth
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Session signing key, 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Initial administrator. Hashed with bcrypt on first start; the plaintext is never stored.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Browser origin(s) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Set to true when served over HTTPS
COOKIE_SECURE=false
